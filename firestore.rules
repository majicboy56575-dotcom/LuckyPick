rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // products: Active draw items
    // Read: Anyone (public listing)
    // Write: Only Cloud Functions (Admin SDK) - no client writes
    // =============================================
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // =============================================
    // closed_products: Completed draws with winners
    // Read: Anyone (public history)
    // Write: Only Cloud Functions (Admin SDK)
    // =============================================
    match /closed_products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // =============================================
    // shipping_infos: Winner shipping details
    // Read: Authenticated users (own data or admin)
    // Write: Only Cloud Functions (Admin SDK)
    // =============================================
    match /shipping_infos/{shippingId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // =============================================
    // users: User profiles
    // Read: Authenticated users (own data or admin)
    // Write: Only Cloud Functions (Admin SDK)
    // =============================================
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'majicboy56575@gmail.com');
      allow write: if false;
    }
  }
}
