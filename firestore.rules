rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'majicboy56575@gmail.com';
    }

    // Active draw items: public read, Cloud Functions write only
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Completed draws with winners: public read, Cloud Functions write only
    match /closed_products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Store catalog tiers: public read, admin/server write only
    match /box_catalogs/{catalogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Special Golden Raffles & scalable entries subcollection: public read, Cloud Functions write only
    match /super_raffles/{raffleId} {
      allow read: if true;
      allow write: if false;

      match /entries/{entryId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Winner shipping details: owner or admin read only, writes via Cloud Functions only
    match /shipping_infos/{shippingId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.winnerUid == request.auth.uid);
      allow write: if false;
    }

    // User profiles, points, golden tickets, vault: owner or admin read only, writes via Cloud Functions only
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if false;
    }

    // Server-only payment and transaction ledgers (zero client access)
    match /payments/{paymentId} {
      allow read, write: if false;
    }
    match /pending_danal_orders/{orderId} {
      allow read, write: if false;
    }
    match /transactions/{txId} {
      allow read, write: if false;
    }
  }
}
