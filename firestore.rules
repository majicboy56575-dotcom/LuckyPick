rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // products: Active draw items
    // Read: Anyone (public listing)
    // Write: Only Cloud Functions (Admin SDK)
    // =============================================
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // =============================================
    // closed_products: Completed draws with winners
    // Read: Anyone (public history)
    // Write: Only Cloud Functions (Admin SDK)
    // =============================================
    match /closed_products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // =============================================
    // box_catalogs: Random box tiers, items, probabilities
    // Read: Anyone (public catalog)
    // Write: Admin only (prevents probability/price tampering)
    // =============================================
    match /box_catalogs/{catalogId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'majicboy56575@gmail.com';
    }

    // =============================================
    // super_raffles: Special Golden Raffles & Multi-group queues
    // Read: Anyone (public transparency)
    // Write: Authenticated users (ticket entry) & Admin (catalog management)
    // =============================================
    match /super_raffles/{raffleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =============================================
    // shipping_infos: Winner shipping details
    // Read & Write: Authenticated users (submit shipping) & Admin (tracking number update)
    // =============================================
    match /shipping_infos/{shippingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // =============================================
    // users: User profiles, points, golden tickets, vault & shipping requests
    // Read & Write: Authenticated users (profile/vault) & Admin
    // =============================================
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
